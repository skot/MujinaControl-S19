	(text "J1 12 V -> protected fan rail -> 5 V converter -> CPU/core -> DDR/1.8 V -> 3.3 V -> RESET_N\nThree UART hashboards, shared hashboard I2C, independent PSU I2C, accessory header J15, four PWM/tach fans.\nUSB-C is a device/recovery port; USB-A is a host port for a WiFi dongle (one at a time)."
		(exclude_from_sim no)
		(at 20.32 235.55 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "665544f5-4beb-5ebf-ab43-5ba18460e603")
	)
	(text "SPI NAND boots first; microSD is available for development.\nJ1-J16 footprints and pin numbering inherited from bitcrane-v3.1, except new accessory header J15; J16 is now 3.3 V UART2 debug.\nAll cross-sheet connections use named global labels. Camera / onboard wireless / USB hub circuits are omitted."
		(exclude_from_sim no)
		(at 20.32 241.4 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "55402038-e85d-4bdf-ba50-a776e2a3420b")
	)
