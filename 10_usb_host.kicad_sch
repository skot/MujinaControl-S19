	(text "U143 feeds J17: 0.5 A rated, current limit 0.67 - 1.01 A. USBA_PWR_EN (GPIO0_A3) is pulled up: on by default; drive low to power-cycle the dongle."
		(exclude_from_sim no)
		(at 40.64 168.783 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "3d2c89a6-74c5-404e-80fb-980e64665ebf")
	)
	(text "USB-A host port (WiFi dongle)"
		(exclude_from_sim no)
		(at 236.22 96.52 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "8cf76b41-6b23-4669-b87d-09816507b94e")
	)
	(text "Layout: 90 ohm differential pairs, short stubs at U142, ESD parts at the socket. Series resistors R252 / R253 stay at the SoC."
		(exclude_from_sim no)
		(at 40.64 174.625 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "a3293226-6dec-4f62-ba2c-e64271e5fc2f")
	)
	(text "The selection is hardware-only, so recovery needs no firmware. Firmware sets the controller role: host for USB-A, device while USB_VBUS_DET is high."
		(exclude_from_sim no)
		(at 40.64 165.862 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "c666a6ee-e36f-44c5-99e6-e9e3656ce238")
	)
	(text "Port switch"
		(exclude_from_sim no)
		(at 86.36 53.34 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "d8da0807-3b1f-43bf-b644-cf9967d385f0")
	)
	(text "A dongle may take up to 0.5 A of the 5 V / 2 A system budget. FLT is not used."
		(exclude_from_sim no)
		(at 40.64 171.704 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "e07ea20f-187d-4026-9839-b9057cd2ad15")
	)
	(text "USB switch and USB-A host"
		(exclude_from_sim no)
		(at 12.7 17.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "e788682f-5b86-4353-8983-b59dc133a33d")
	)
	(text "The SoC has one USB 2.0 port. U142 connects it to USB-C (J2, sheet 7) or to USB-A (J17), never both."
		(exclude_from_sim no)
		(at 40.64 160.02 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "ec075c4a-c82f-4f5b-84d2-cca8dc841d95")
	)
	(text "Port power: 0.5 A, current-limited"
		(exclude_from_sim no)
		(at 185.42 34.29 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
