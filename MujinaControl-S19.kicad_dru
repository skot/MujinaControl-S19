(version 2)

(rule "RV1106 local copper clearance"
	# RV1106G2 0.35 mm pitch local fanout; see docs/rv1106-fanout-rules.md.
	(condition "A.intersectsCourtyard('U100') && B.intersectsCourtyard('U100')")
	(layer "F.Cu")
	(constraint clearance (min 0.127mm))
)

(rule "RV1106 short pad escape widths"
	# RV1106G2 0.35 mm pitch local fanout; see docs/rv1106-fanout-rules.md.
	(condition "A.Type == 'Track' && A.intersectsCourtyard('U100')")
	(layer "F.Cu")
	(constraint track_width (min 0.127mm) (opt 0.15mm))
)

(rule "RV1106 through-via fanout"
	# RV1106G2 0.35 mm pitch local fanout; see docs/rv1106-fanout-rules.md.
	(condition "A.Type == 'Via' && A.intersectsCourtyard('U100')")
	(constraint via_diameter (min 0.45mm) (opt 0.45mm))
	(constraint hole_size (min 0.3mm) (opt 0.3mm))
)

(rule "RV1106 pair launch gap"
	# RV1106G2 0.35 mm pitch local fanout; see docs/rv1106-fanout-rules.md.
	(condition "A.inDiffPair('*') && A.intersectsCourtyard('U100')")
	(layer "F.Cu")
	(constraint diff_pair_gap (min 0.127mm) (opt 0.2mm))
)

(rule "RV1106 local via hole to track"
	# Fab published via-hole-to-track minimum 0.20 mm; verified capabilities 2026-11-08. See docs/sd-routing.md.
	(condition "A.intersectsCourtyard('U100') && B.intersectsCourtyard('U100') && ((A.Type == 'Via' && B.Type == 'Track') || (A.Type == 'Track' && B.Type == 'Via'))")
	(layer "F.Cu")
	(constraint hole_clearance (min 0.2mm))
)

(rule "USB switch pad pitch clearance"
	# FSUSB42 MSOP-10, 0.5 mm pitch: 0.15 mm between its pads. See docs/usb-host-jtag.md.
	(condition "A.intersectsCourtyard('U142') && B.intersectsCourtyard('U142')")
	(layer "F.Cu")
	(constraint clearance (min 0.127mm))
)
